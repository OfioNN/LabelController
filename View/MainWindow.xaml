<Window x:Class="LabelController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:vm="clr-namespace:LabelController.ViewModel"
        Title="Label Editor"
        Width="1200"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F4">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Viewbox Grid.Row="0" Stretch="Uniform">
                <Border Width="352"
                        Height="242"
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Image Name="ImgBackground"
                               Stretch="UniformToFill"
                               Source="https://via.placeholder.com/352x242"/>

                        <StackPanel VerticalAlignment="Top"
                                    Background="#EFFFFFFF">

                            <TextBlock Text="{Binding ProductName}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,5"/>

                            <TextBlock Text="{Binding Ingredients}"
                                       FontSize="10"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxHeight="80"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Viewbox>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0">
                <Button Content="Wróć" Width="120" Margin="0,0,10,0" Style="{StaticResource MainButton}" Background="#202020"/>

                <Button Width="100" Style="{StaticResource MainButton}" Background="#DC2626">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="TrashCan" Foreground="White" Width="14" Height="14"/>
                        <TextBlock Text="Usuń" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Nazwa produktu"/>
                    <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                             Height="35"
                             Margin="0,5,0,10"/>

                    <TextBlock Text="Składniki"/>
                    <TextBox Text="{Binding Ingredients, UpdateSourceTrigger=PropertyChanged}"
                             Height="100"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Margin="0,5,0,10"/>

                    <TextBlock Text="Co ma się znajdować w tle?"/>
                    <CheckBox Content="To samo co w składnikach"
                              Margin="0,5"/>
                    <TextBox x:Name="TxtAiPrompt"
                             Height="35"
                             Margin="0,5,0,10"/>

                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Generuj tło" Style="{StaticResource MainButton}" Margin="0,0,5,0"/>
                        <Button Grid.Column="1" Content="Usuń tło" Style="{StaticResource MainButton}" Background="#C83232" Margin="5,0,0,0"/>
                    </Grid>

                    <Expander Header="Pokaż więcej opcji" Margin="0,15,0,0" FontWeight="SemiBold">
                        <StackPanel Margin="0,10,0,0">

                            <TextBlock Text="Producent"/>
                            <TextBox Text="{Binding Producer, UpdateSourceTrigger=PropertyChanged}"
                                     Height="35"
                                     Margin="0,5,0,10"/>

                            <TextBlock Text="Opis"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     Height="60"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Margin="0,5,0,10"/>

                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Drukuj" Style="{StaticResource MainButton}" Background="#2563EB" Margin="0,0,5,0"/>
                <Button Grid.Column="1" Content="Zapisz" Command="{Binding SaveCommand}" Style="{StaticResource MainButton}" Background="#16A34A" Margin="5,0,0,0"/>
            </Grid>
        </Grid>

    </Grid>
</Window>